<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema
        xmlns:sbe="http://fixprotocol.io/2016/sbe"
        xmlns:xi="http://www.w3.org/2001/XInclude"
        package="test.trading"
        id="42"
        version="2"
        byteOrder="littleEndian"
        description="Test schema covering the SBE features the serde decodes">
    <xi:include href="common-types.xml"/>

    <types>
        <composite name="Decimal" description="FIX-style decimal">
            <type name="mantissa" primitiveType="int64"/>
            <type name="exponent" primitiveType="int8"/>
        </composite>
        <composite name="OptionalDecimal">
            <type name="mantissa" primitiveType="int64" presence="optional"/>
            <type name="exponent" primitiveType="int8"/>
        </composite>
        <composite name="BigDecimalValue" description="Java BigDecimal representation: unscaled bytes and scale">
            <type name="length" primitiveType="uint8" maxValue="16"/>
            <type name="mantissa" primitiveType="int8" length="16"/>
            <type name="exponent" primitiveType="uint8"/>
        </composite>
        <composite name="Fill">
            <ref name="priceLength" type="UnscaledLength"/>
            <ref name="priceMantissa" type="UnscaledBytes"/>
            <ref name="priceExponent" type="Scale"/>
            <type name="venue" primitiveType="char" length="8"/>
        </composite>

        <enum name="Side" encodingType="char">
            <validValue name="BID">B</validValue>
            <validValue name="ASK">A</validValue>
        </enum>
        <enum name="Status" encodingType="uint8">
            <validValue name="NEW">0</validValue>
            <validValue name="FILLED">1</validValue>
        </enum>
        <set name="Flags" encodingType="uint8">
            <choice name="hidden">0</choice>
            <choice name="reduceOnly">1</choice>
            <choice name="postOnly">2</choice>
        </set>

        <type name="OptionalInt32" primitiveType="int32" presence="optional"/>
        <type name="Source" primitiveType="char" length="4" presence="constant">TEST</type>
    </types>

    <sbe:message name="Order" id="1" description="Order">
        <field name="orderId" id="1" type="uint64"/>
        <field name="symbol" id="2" type="Symbol"/>
        <field name="side" id="3" type="Side"/>
        <field name="status" id="4" type="Status"/>
        <field name="flags" id="5" type="Flags"/>
        <field name="price" id="6" type="Decimal"/>
        <field name="stopPrice" id="7" type="OptionalDecimal"/>
        <field name="quantity" id="8" type="BigDecimalValue"/>
        <field name="displayQuantity" id="9" type="OptionalInt32"/>
        <field name="source" id="10" type="Source"/>
        <field name="tag" id="11" type="OptionalInt32" sinceVersion="2"/>
        <group name="fills" id="12" dimensionType="groupSizeEncoding">
            <field name="executionId" id="13" type="uint64"/>
            <field name="fill" id="14" type="Fill"/>
        </group>
        <data name="note" id="15" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="Heartbeat" id="2" description="Heartbeat">
        <field name="timestamp" id="1" type="uint64"/>
    </sbe:message>
</sbe:messageSchema>
